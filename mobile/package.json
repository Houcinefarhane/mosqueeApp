{
  "name": "madrasapp-mobile",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Coque iOS / Android MadrasApp (WebView → site Vercel)",
  "scripts": {
    "config:check": "node scripts/check-env.js",
    "sync": "npm run config:check && npx --yes node@22 ./node_modules/@capacitor/cli/bin/capacitor sync",
    "open:ios": "npx --yes node@22 ./node_modules/@capacitor/cli/bin/capacitor open ios",
    "open:android": "npx --yes node@22 ./node_modules/@capacitor/cli/bin/capacitor open android",
    "run:ios": "npx --yes node@22 ./node_modules/@capacitor/cli/bin/capacitor run ios",
    "run:android": "npx --yes node@22 ./node_modules/@capacitor/cli/bin/capacitor run android",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#C8962E' --iconBackgroundColorDark '#1E110A' --splashBackgroundColor '#1E110A' --splashBackgroundColorDark '#1E110A'"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
