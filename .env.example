# ── Neon PostgreSQL (recommandé — dev + prod) ───────────────────────────────
# Console : https://console.neon.tech/
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-1.aws.neon.tech/madrasa?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/madrasa?sslmode=require"
# (Neon : « Pooled » pour DATABASE_URL, « Direct » pour DIRECT_DATABASE_URL — migrations Prisma)

# ── PostgreSQL local (Docker) ─────────────────────────────────────────────
# DATABASE_URL="postgresql://madrasa:madrasa@localhost:5433/madrasa"

NEXTAUTH_SECRET="change-me"          # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3002"
# RESEND_API_KEY="..."               # optionnel

