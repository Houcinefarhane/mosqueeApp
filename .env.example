# MadrasaApp — Variables d'environnement

# PostgreSQL — choisir UNE option :

# Option A : PostgreSQL local (Homebrew, sans Docker)
#   brew services start postgresql@14
#   createdb madrasa
DATABASE_URL="postgresql://VOTRE_USER@localhost:5432/madrasa?schema=public"

# Option B : Docker (npm run db:docker)
# DATABASE_URL="postgresql://madrasa:madrasa@localhost:5433/madrasa?schema=public"

# Option C : Neon (cloud)
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generer-avec-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3002"

# Application (URL publique)
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Emails (optionnel — Resend)
# RESEND_API_KEY="re_xxxxxxxx"
