{
  "name": "madras-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:log": "next dev -p 3002 2>&1 | tee .dev-server.log",
    "perf:watch": "bash scripts/watch-perf.sh",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "build:vercel": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test": "tsx scripts/test-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-charge": "tsx prisma/seed-charge.ts",
    "import:amp": "tsx scripts/import-amp.ts",
    "import:profs-amp": "tsx scripts/import-profs-amp.ts",
    "create:admin-amp": "tsx scripts/create-admin-amp.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:docker": "docker compose up -d",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker logs madrasa-postgres -f --tail 50"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.427.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.7",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.40",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  }
}
